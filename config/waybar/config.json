{
  "layer": "top",
  "position": "top",
  "height": 31,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,

  "modules-left": [
    "cpu",
    "memory",
    "clock",
    "niri/workspaces"
  ],
  "modules-center": [
    "niri/window"
  ],
  "modules-right": [
    "disk",
    "custom/balance",
    "backlight",
    "network",
    "pulseaudio",
    "pulseaudio#microphone",
    "tray",
    "battery",
    "custom/power"
  ],

  "cpu": {
    "interval": 10,
    "format": "<span color='#8f9a85'>cpu</span> {usage}%"
  },

  "memory": {
    "interval": 30,
    "format": "<span color='#8f9a85'>memory</span> {used:0.1f}GB",
    "tooltip-format": "{percentage}%\n{used:0.1f}GB / {total:0.1f}GB"
  },

  "clock": {
    // Interval of 1 so the seconds actually tick
    "interval": 1,
    "format": "{:%H:%M:%S  ·  %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#d6cfb4'><b>{}</b></span>",
        "days": "<span color='#8f9a85'>{}</span>",
        "weekdays": "<span color='#c2a35a'><b>{}</b></span>",
        "today": "<span color='#a8504a'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "default": "·"
    }
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 50
  },

  "disk": {
    "interval": 60,
    "path": "/",
    "format": "<span color='#8f9a85'>disk</span> {free}",
    "tooltip-format": "{used} used of {total} ({percentage_used}%)"
  },

  "custom/balance": {
    "interval": 600,
    "exec": "/home/ente/src/3nt3/balance-notifications/.venv/bin/python3 /home/ente/src/3nt3/balance-notifications/main.py",
    "return-type": "json"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "<span color='#8f9a85'>bri</span> {percent}%",
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-"
  },

  "network": {
    "interval": 2,
    "format-wifi": "<span color='#8f9a85'>wifi</span> {signalStrength}%",
    "format-ethernet": "<span color='#8f9a85'>eth</span>",
    "format-linked": "<span color='#8f9a85'>eth</span> (no ip)",
    "format-disconnected": "<span color='#8f9a85'>offline</span>",
    "format-alt": "<span color='#7fa37a'>down {bandwidthDownBytes}</span>  <span color='#c2a35a'>up {bandwidthUpBytes}</span>",
    "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}\n{signaldBm} dBm, {frequency} MHz",
    "tooltip-format-disconnected": "Disconnected"
  },

  "pulseaudio": {
    "format": "<span color='#8f9a85'>vol</span> {volume}%",
    "format-muted": "<span color='#8f9a85'>muted</span>",
    "scroll-step": 5,
    "on-click": "pavucontrol -t 3",
    // Middle click toggles mute (plain pactl, no helper script needed)
    "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "{desc} // {volume}%"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#8f9a85'>mic</span>",
    "format-source-muted": "<span color='#8f9a85'>mic off</span>",
    "scroll-step": 5,
    "on-click": "pavucontrol -t 4",
    "on-click-middle": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "tooltip-format": "{source_desc} // {source_volume}%"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 20
    },
    "format": "<span color='#8f9a85'>bat</span> {capacity}%",
    "format-charging": "<span color='#8f9a85'>chg</span> {capacity}%",
    "format-plugged": "<span color='#8f9a85'>ac</span> {capacity}%",
    "format-alt": "{time}"
  },

  "custom/power": {
    "format": "<span color='#8f9a85'>exit</span>",
    // Shows niri's own confirmation dialog before quitting
    "on-click": "niri msg action quit",
    "tooltip": false
  }
}
